package views

type ReadinessView struct {
	Title  string
	Body   string
	Href   string
	Action string
	Done   bool
}

type NeedView struct {
	Title string
	Body  string
	Href  string
	Icon  string
	Kind  string
}

type OverviewView struct {
	Greeting   string
	StatusText string
	StatusOK   bool
	Stats      []StatView
	Recent     []InboxConversationView
	Readiness  []ReadinessView
	Needs      []NeedView
	Pending    int
	SourceCount int
}

templ dashboardContent(view OverviewView) {
	@pageHead("Overview", view.Greeting, nil)
	<div class={ "status-line " + yesNo(view.StatusOK, "", "status-line--idle") }>
		<span class="status-line__dot"></span>
		<span>{ view.StatusText }</span>
	</div>
	<div class="stat-row">
		for _, stat := range view.Stats {
			<div class="card stat">
				<div class="stat__top"><span class="stat__label">{ stat.Label }</span><span class="stat__icon">@icon(stat.Icon, "")</span></div>
				<span class="stat__value">{ stat.Value }</span>
				<span class="stat__hint">{ stat.Hint }</span>
			</div>
		}
	</div>
	<div class="dashboard-grid">
		<div class="stack">
			<section class="card card--flush">
				<div class="card__head">
					<div><h2 class="card__title">Recent conversations</h2><p class="card__sub">Newest activity across the widget and API.</p></div>
					<a class="link" href="/dashboard/inbox">Open inbox @icon("arrow-right", "")</a>
				</div>
				if len(view.Recent) == 0 {
					<div class="card__body">
						@emptyState(EmptyView{Icon: "inbox", Title: "The desk is quiet", Body: "No conversations yet. Embed the widget on your site or call the API. The first message will appear here with its citations and handoff."}, nil)
					</div>
				} else {
					<div class="list">
						for _, conversation := range view.Recent {
							<a class="list__item list__item--link" href={ "/dashboard/inbox/" + conversation.ID }>
								@avatar(conversation.CustomerName, "")
								<span class="list__main">
									<span class="list__title"><span class="truncate">{ conversation.CustomerName }</span>@statusBadge(conversation.Status)</span>
									<span class="list__preview">{ stringOr(conversation.Preview, "No messages yet") }</span>
								</span>
								<span class="list__aside"><span>{ conversation.Time }</span><span>{ conversation.ChannelLabel }</span></span>
							</a>
						}
					</div>
				}
			</section>
			<section class="card card--flush">
				<div class="card__head">
					<div><h2 class="card__title">What needs a human</h2><p class="card__sub">The queue the AI deliberately did not close.</p></div>
					<span class={ "badge " + yesNo(view.Pending > 0, "badge--warn", "") }>{ itoa(view.Pending) } pending</span>
				</div>
				if len(view.Needs) == 0 {
					<div class="card__body"><div class="done-list"><div class="done-item">@icon("check-circle", "")<span><strong>Nothing is waiting.</strong> No approvals, no handoffs, no failed ingests. The desk is holding.</span></div></div></div>
				} else {
					<div class="needs">
						for _, need := range view.Needs {
							<a class="needs__item" href={ need.Href }>
								<span class="needs__icon">@icon(need.Icon, "")</span>
								<span class="needs__main"><span class="needs__title">{ need.Title }</span><span class="needs__body">{ need.Body }</span></span>
								<span class="needs__go">@icon("arrow-right", "")</span>
							</a>
						}
					</div>
				}
			</section>
		</div>
		<div class="stack">
			<section class="card">
				<div class="card__head"><div><h2 class="card__title">Agent readiness</h2><p class="card__sub">Four checks between you and a working desk.</p></div></div>
				<div class="card__body readiness">
					for _, item := range view.Readiness {
						<div class="readiness__item" data-done={ yesNo(item.Done, "true", "false") }>
							<span class="readiness__mark">@icon("check", "")</span>
							<span class="readiness__main"><span class="readiness__title">{ item.Title }</span><span class="readiness__body">{ item.Body }</span></span>
							if item.Href != "" {
								<a class="readiness__action link" href={ item.Href }>{ item.Action }</a>
							}
						</div>
					}
				</div>
			</section>
			<section class="card">
				<div class="card__head"><div><h2 class="card__title">Quick actions</h2><p class="card__sub">The short path to a change.</p></div></div>
				<div class="card__body">
					<div class="quick-actions">
						<a class="quick-action" href="/dashboard/knowledge?add=url">@icon("globe", "") Add a website source</a>
						<a class="quick-action" href="/dashboard/settings?section=agent">@icon("bot", "") Tune the agent</a>
						<a class="quick-action" href="/dashboard/settings?section=widget">@icon("message", "") Widget and embed</a>
						<a class="quick-action" href="/dashboard/settings?section=api-keys">@icon("lock", "") Create an API key</a>
					</div>
				</div>
			</section>
			if view.SourceCount == 0 {
				<section class="card card--accent">
					<div class="card__body stack stack--sm">
						<p class="eyebrow">First step</p>
						<h2 class="card__title">Give the agent something true to read.</h2>
						<p class="muted small">With no knowledge, the desk still answers, but it escalates rather than guessing. Add one help page to change that.</p>
						<a class="btn btn--primary btn--sm" href="/dashboard/knowledge?add=url">Add knowledge</a>
					</div>
				</section>
			}
		</div>
	</div>
}

templ DashboardPage(shell ShellView, view OverviewView) {
	@appShell(shell) {
		@dashboardContent(view)
	}
}
