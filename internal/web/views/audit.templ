package views

import templpkg "github.com/a-h/templ"

type AuditEventView struct {
	ID        int64
	Type      string
	ActorType string
	ActorID   string
	Target    string
	Payload   string
	CreatedAt string
	Icon      string
}

type AuditView struct {
	Events     []AuditEventView
	Types      []string
	TypeFilter string
	Actor      string
	Query      string
	NextBefore int64
	HasMore    bool
	Showing    int
}

func auditIcon(eventType string) string {
	switch {
	case len(eventType) >= 4 && eventType[:4] == "auth":
		return "user"
	case len(eventType) >= 8 && eventType[:8] == "settings":
		return "settings"
	case len(eventType) >= 9 && eventType[:9] == "knowledge":
		return "book"
	case len(eventType) >= 3 && eventType[:3] == "run":
		return "bot"
	case len(eventType) >= 6 && eventType[:6] == "action":
		return "approvals"
	case len(eventType) >= 12 && eventType[:12] == "conversation":
		return "message"
	}
	return "scroll"
}

func auditTone(eventType string) string {
	switch eventType {
	case "auth.failed", "knowledge.ingest.failed", "action.failed":
		return "badge badge--danger"
	case "run.escalated", "action.requested":
		return "badge badge--warn"
	case "run.completed", "action.verified", "knowledge.ingest.completed":
		return "badge badge--success"
	}
	return "badge"
}

func auditHref(view AuditView, before int64) string {
	href := "/dashboard/audit?before=" + itoa64(before)
	if view.TypeFilter != "" {
		href += "&type=" + urlQueryEscape(view.TypeFilter)
	}
	if view.Actor != "" {
		href += "&actor=" + urlQueryEscape(view.Actor)
	}
	if view.Query != "" {
		href += "&q=" + urlQueryEscape(view.Query)
	}
	return href
}

func auditExportHref(view AuditView) string {
	href := "/dashboard/audit/export?"
	if view.TypeFilter != "" {
		href += "type=" + urlQueryEscape(view.TypeFilter) + "&"
	}
	if view.Actor != "" {
		href += "actor=" + urlQueryEscape(view.Actor) + "&"
	}
	if view.Query != "" {
		href += "q=" + urlQueryEscape(view.Query)
	}
	return href
}

templ auditContent(view AuditView) {
	@pageHead("Audit log", "An append-only record of security-relevant actions. Payloads are redacted at write time; rows cannot be updated or deleted by the application role.", nil)
	<section class="card">
		<form method="get" action="/dashboard/audit" class="card__body form">
			<div class="form-row">
				<div class="field">
					<label class="field__label" for="type">Event type</label>
					<select class="select" id="type" name="type" data-auto-submit>
						<option value="">All events</option>
						for _, eventType := range view.Types {
							<option value={ eventType } selected?={ view.TypeFilter == eventType }>{ eventType }</option>
						}
					</select>
				</div>
				<div class="field">
					<label class="field__label" for="actor">Actor</label>
					<input class="input" id="actor" name="actor" type="text" value={ view.Actor } placeholder="user, agent, or system"/>
				</div>
				<div class="field">
					<label class="field__label" for="q">Search</label>
					<input class="input" id="q" name="q" type="search" value={ view.Query } placeholder="type or target"/>
				</div>
				<div class="field" style="align-content:end;">
					<div class="row row--tight">
						<button class="btn btn--primary btn--sm" type="submit">@icon("filter", "") Filter</button>
						<a class="btn btn--secondary btn--sm" href="/dashboard/audit">Clear</a>
						<a class="btn btn--ghost btn--sm" href={ templpkg.SafeURL(auditExportHref(view)) }>@icon("download", "") CSV</a>
					</div>
				</div>
			</div>
		</form>
	</section>
	<section class="card card--flush">
		<div class="card__head">
			<div><h2 class="card__title">Events</h2><p class="card__sub">{ countLabel(view.Showing, "event", "events") } in this page, newest first.</p></div>
			<span class="scope-chip">{ countLabel(len(view.Events), "row", "rows") }</span>
		</div>
		if len(view.Events) == 0 {
			<div class="card__body">
				@emptyState(EmptyView{Icon: "scroll", Title: "No audit events match", Body: "Security-relevant actions from the desk will appear here. Clear the filters to see everything for this workspace."}, nil)
			</div>
		} else {
			<div class="audit-list">
				for _, event := range view.Events {
					<article class="event">
						<span class="event__icon">@icon(event.Icon, "")</span>
						<div>
							<div class="event__type">{ event.Type }</div>
							<div class="event__target">{ event.Target }</div>
						</div>
						<div class="event__actor">{ event.ActorType }{ actorSuffix(event.ActorID) }</div>
						<div class="event__time">{ event.CreatedAt }</div>
						if event.Payload != "" {
							<details class="event__payload">
								<summary>Payload</summary>
								<pre>{ event.Payload }</pre>
							</details>
						}
					</article>
				}
			</div>
			<div class="pagination">
				<span>Showing { countLabel(view.Showing, "event", "events") }</span>
				if view.HasMore {
					<a class="btn btn--secondary btn--sm" href={ templpkg.SafeURL(auditHref(view, view.NextBefore)) }>Older events @icon("arrow-right", "")</a>
				} else {
					<span class="muted">End of the log</span>
				}
			</div>
		}
	</section>
}

func actorSuffix(actorID string) string {
	if actorID == "" {
		return ""
	}
	return " (" + actorID + ")"
}

templ AuditPage(shell ShellView, view AuditView) {
	@appShell(shell) {
		@auditContent(view)
	}
}
