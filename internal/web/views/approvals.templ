package views

type ApprovalRowView struct {
	ID             string
	ConversationID string
	CustomerName   string
	CustomerEmail  string
	ToolID         string
	Args           string
	CreatedAt      string
	Status         string
}

type ApprovalsView struct {
	Pending  []ApprovalRowView
	History  []ApprovalRowView
	CanUse   bool
}

templ approvalsContent(view ApprovalsView) {
	@pageHead("Approvals", "Risky actions pause here. Approving executes the tool once, then a verification step decides whether the customer sees “done”.", nil)
	<section class="card card--flush">
		<div class="card__head"><div><h2 class="card__title">Waiting on a human</h2><p class="card__sub">Nothing here has executed yet.</p></div><span class={ "badge " + yesNo(len(view.Pending) > 0, "badge--warn", "") }>{ countLabel(len(view.Pending), "request", "requests") }</span></div>
		if len(view.Pending) == 0 {
			<div class="card__body">
				@emptyState(EmptyView{Icon: "check-circle", Title: "No approvals waiting", Body: "When the agent reaches a tool that needs a human decision, it stops the run and leaves the request here with the exact arguments."}, nil)
			</div>
		} else {
			<div class="card__body stack">
				for _, approval := range view.Pending {
					<div class="approval">
						<div class="approval__head">
							<span class="approval__tool">{ approval.ToolID }</span>
							<span class="scope-chip">requested { approval.CreatedAt }</span>
						</div>
						<pre class="approval__args">{ approval.Args }</pre>
						<div class="approval__actions">
							<div class="row" style="margin-inline-end:auto;">
								@avatar(approval.CustomerName, "avatar--sm")
								<span class="small"><strong>{ approval.CustomerName }</strong><span class="muted"> · { approval.CustomerEmail }</span></span>
							</div>
							<a class="btn btn--ghost btn--sm" href={ "/dashboard/inbox/" + approval.ConversationID }>Open conversation</a>
							<form method="post" action="/dashboard/inbox/action">
								<input type="hidden" name="actionId" value={ approval.ID }/>
								<input type="hidden" name="conversationId" value={ approval.ConversationID }/>
								<input type="hidden" name="returnTo" value="/dashboard/approvals"/>
								<button class="btn btn--primary btn--sm" type="submit" name="decision" value="approve">Approve</button>
								<button class="btn btn--danger btn--sm" type="submit" name="decision" value="reject">Reject</button>
							</form>
						</div>
					</div>
				}
			</div>
		}
	</section>
	<section class="card card--flush">
		<div class="card__head"><div><h2 class="card__title">Recent decisions</h2><p class="card__sub">The last twenty decided actions, newest first.</p></div></div>
		if len(view.History) == 0 {
			<div class="card__body"><p class="muted small">No decisions have been made yet.</p></div>
		} else {
			<div class="list">
				for _, approval := range view.History {
					<a class="list__item list__item--link" href={ "/dashboard/inbox/" + approval.ConversationID }>
						<span class="source__type">@icon("approvals", "")</span>
						<span class="list__main">
							<span class="list__title"><span class="truncate">{ approval.ToolID }</span>@statusBadge(approval.Status)</span>
							<span class="list__sub">{ approval.CustomerName } · decided { approval.CreatedAt }</span>
						</span>
						<span class="needs__go">@icon("chevron-right", "")</span>
					</a>
				}
			</div>
		}
	</section>
}

templ ApprovalsPage(shell ShellView, view ApprovalsView) {
	@appShell(shell) {
		@approvalsContent(view)
	}
}
