templ statusBadge(status string) {
	<span class={ badgeClass(status) } data-tone={ status }>
		<span class="badge__dot"></span>
		{ statusLabel(status) }
	</span>
}

templ avatar(name string, size string) {
	<span class={ "avatar " + size } aria-hidden="true">{ initial(name) }</span>
}

templ pageHead(title string, sub string, actions templpkg.Component) {
	<header class="page-head">
		<div class="page-head__main">
			<h1 class="page-head__title">{ title }</h1>
			if sub != "" {
				<p class="page-head__sub">{ sub }</p>
			}
		</div>
		<div class="page-head__actions">
			if actions != nil {
				@actions
			}
		</div>
	</header>
}

templ emptyState(view EmptyView, action templpkg.Component) {
	<div class="empty">
		<div class="empty__icon">@icon(view.Icon, "")</div>
		<h2 class="empty__title">{ view.Title }</h2>
		<p class="empty__body">{ view.Body }</p>
		if action != nil {
			@action
		}
	</div>
}

templ alertBox(tone string, title string, body string) {
	<div class={ "alert alert--" + tone } data-alert role="status">
		@icon("info", "")
		<div class="alert__body">
			if title != "" {
				<strong class="alert__title">{ title }</strong>
			}
			{ body }
		</div>
	</div>
}

templ flashMessage(message string, tone string) {
	if message != "" {
		<div class={ "alert alert--" + stringOr(tone, "success") } data-alert>
			@icon("check-circle", "")
			<div class="alert__body">{ message }</div>
			<button type="button" class="icon-btn" data-dismiss aria-label="Dismiss">@icon("x", "")</button>
		</div>
	}
}
