package views

import (
	"fmt"
	"strings"
	"time"

	templpkg "github.com/a-h/templ"
)

type ShellView struct {
	Active              string
	PageTitle           string
	PageSub             string
	UserName            string
	UserEmail           string
	UserInitial         string
	Role                string
	OrgName             string
	OrgInitial          string
	OpenConversations   int
	PendingApprovals    int
	OnboardingIncomplete bool
	CanAudit            bool
	CanSettings         bool
	CanKnowledgeWrite   bool
	Flash               string
	FlashTone           string
	InboxStream         bool
}

type StatView struct {
	Label string
	Value string
	Hint  string
	Icon  string
}

type EmptyView struct {
	Icon  string
	Title string
	Body  string
}

func initial(name string) string {
	name = strings.TrimSpace(name)
	if name == "" {
		return "?"
	}
	parts := strings.Fields(name)
	if len(parts) == 1 {
		runes := []rune(parts[0])
		if len(runes) == 0 {
			return "?"
		}
		return strings.ToUpper(string(runes[0]))
	}
	first := []rune(parts[0])
	last := []rune(parts[len(parts)-1])
	if len(first) == 0 || len(last) == 0 {
		return "?"
	}
	return strings.ToUpper(string(first[0]) + string(last[0]))
}

func statusLabel(status string) string {
	return strings.ReplaceAll(status, "_", " ")
}

func statusTone(status string) string {
	switch status {
	case "resolved", "closed", "ready", "executed", "approved", "success", "grounded":
		return "success"
	case "awaiting_human", "pending_approval", "pending", "fetching", "indexing", "warn":
		return "warn"
	case "failed", "rejected", "rejected_before_exec", "danger":
		return "danger"
	case "ai_active", "human_active", "internal", "info":
		return "info"
	}
	return ""
}

func badgeClass(status string) string {
	tone := statusTone(status)
	if tone == "" {
		return "badge"
	}
	return "badge badge--" + tone
}

func relativeTime(t time.Time) string {
	if t.IsZero() {
		return "-"
	}
	now := time.Now()
	diff := now.Sub(t)
	if diff < 0 {
		diff = 0
	}
	switch {
	case diff < time.Minute:
		return "just now"
	case diff < time.Hour:
		return fmt.Sprintf("%dm ago", int(diff.Minutes()))
	case diff < 24*time.Hour:
		return fmt.Sprintf("%dh ago", int(diff.Hours()))
	case diff < 48*time.Hour:
		return "yesterday"
	case diff < 7*24*time.Hour:
		return fmt.Sprintf("%dd ago", int(diff.Hours()/24))
	}
	if t.Year() == now.Year() {
		return t.Format("Jan 2")
	}
	return t.Format("Jan 2, 2006")
}

func fullTime(t time.Time) string {
	if t.IsZero() {
		return "-"
	}
	return t.Format("Jan 2, 2006 · 15:04")
}

func shortDate(value string) string {
	parsed, err := time.Parse("2006-01-02", value)
	if err != nil {
		return value
	}
	return parsed.Format("Jan 2")
}

func roleLabel(role string) string {
	switch role {
	case "owner":
		return "Owner"
	case "admin":
		return "Admin"
	case "agent":
		return "Agent"
	}
	return role
}

func channelLabel(channel string) string {
	switch channel {
	case "widget":
		return "Chat widget"
	case "api":
		return "API"
	}
	return channel
}

func countLabel(n int, singular, plural string) string {
	if n == 1 {
		return fmt.Sprintf("1 %s", singular)
	}
	return fmt.Sprintf("%d %s", n, plural)
}

func maskTail(value string) string {
	if value == "" {
		return ""
	}
	if len(value) <= 4 {
		return "••••"
	}
	return "••••" + value[len(value)-4:]
}

func stringOr(value, fallback string) string {
	if strings.TrimSpace(value) == "" {
		return fallback
	}
	return value
}

