# syntax=docker/dockerfile:1
# ChasteDesk worker (pg-boss jobs: ingestion, AI runs, analytics)
FROM node:24-alpine AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/db/package.json packages/db/
COPY packages/ai/package.json packages/ai/
COPY packages/retrieval/package.json packages/retrieval/
COPY packages/shared/package.json packages/shared/
COPY packages/ui/package.json packages/ui/
RUN corepack enable && pnpm install --frozen-lockfile --prod=false

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/worker/node_modules ./apps/worker/node_modules
COPY --from=deps /app/packages ./packages
COPY --from=build /app/apps/worker/src ./apps/worker/src
COPY --from=deps /app/apps/worker/package.json ./apps/worker/
COPY --from=deps /app/package.json ./package.json
COPY --from=deps /app/packages/db/drizzle ./packages/db/drizzle
COPY tsconfig.base.json ./
CMD ["node", "--import", "tsx", "apps/worker/src/index.ts"]
