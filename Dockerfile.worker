# syntax=docker/dockerfile:1
# ChasteDesk worker: ingestion, AI runs, action execution, analytics rollups.
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/chastedesk-worker ./cmd/worker

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata \
 && addgroup -S chastedesk && adduser -S -G chastedesk chastedesk \
 && mkdir -p /data/uploads && chown -R chastedesk:chastedesk /data
WORKDIR /app
COPY --from=build /out/chastedesk-worker /app/chastedesk-worker
USER chastedesk
VOLUME ["/data/uploads"]
ENTRYPOINT ["/app/chastedesk-worker"]
