# syntax=docker/dockerfile:1
# ChasteDesk web: Go HTTP server, React console, legacy pages, widget, and API.
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/chastedesk-web ./cmd/web \
 && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/chastedesk-migrate ./cmd/migrate

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata wget \
 && addgroup -S chastedesk && adduser -S -G chastedesk chastedesk
WORKDIR /app
COPY --from=build /out/chastedesk-web /app/chastedesk-web
COPY --from=build /out/chastedesk-migrate /app/chastedesk-migrate
USER chastedesk
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=5 \
  CMD wget -qO- http://127.0.0.1:3000/api/ready >/dev/null || exit 1
ENTRYPOINT ["/app/chastedesk-web"]
