# ChasteDesk environment
# Copy to .env and fill in. APP_SECRET is required.

# Postgres connection string (pgvector image)
DATABASE_URL=postgresql://chastedesk:chastedesk@localhost:5432/chastedesk

# 32+ byte random secret, e.g. `openssl rand -base64 48`
APP_SECRET=change-me-to-a-long-random-string

# Public URL of the web app
APP_URL=http://localhost:3000

# Web server port
PORT=3000

# debug | info | warn | error
LOG_LEVEL=info

# Worker job concurrency
WORKER_CONCURRENCY=4

# TEST ONLY: allows the ingestion crawler to fetch private/loopback addresses.
# Read only when NODE_ENV != production. Never set in production.
# CHASTESK_INGEST_ALLOW_PRIVATE=1
