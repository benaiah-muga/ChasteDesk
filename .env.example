# ChasteDesk environment
# Copy to .env, then set APP_SECRET. docker compose reads this file automatically.

# Public URL of the web app. Used for widget snippets, secure cookies, and CSRF checks.
APP_URL=http://localhost:3000

# Host port for the web container (the Go server always listens on 3000 inside).
PORT=3000

# 32+ byte random secret. Generate with: openssl rand -base64 48
# Changing this invalidates provider keys and widget tokens.
APP_SECRET=change-me-to-a-long-random-string

# Postgres password used by the bundled compose database.
POSTGRES_PASSWORD=chastedesk

# development | test | production. Compose sets production; never lower it in production.
APP_ENV=development

# debug | info | warn | error
LOG_LEVEL=info

# Worker concurrency per queue (1-64).
WORKER_CONCURRENCY=4

# Only needed for manual (non-compose) runs:
# DATABASE_URL=postgresql://chastedesk:chastedesk@localhost:5432/chastedesk
# UPLOADS_DIR=data/uploads

# Optional embedding provider for hybrid retrieval. Without this, retrieval uses
# Postgres full-text search only. Reindex sources after enabling embeddings.
# Local Ollama example (requires an Ollama version that supports the chosen model):
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=embeddinggemma-2:270m-bf16-text
# EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_API_KEY=
# For hosted or OpenAI-compatible embedding endpoints:
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.example.com/v1
# EMBEDDING_API_KEY=

# Prometheus metrics are served at /metrics. Set a token to require
# Authorization: Bearer <token>. In production the endpoint is hidden unless a
# token is configured. Generate one with: openssl rand -base64 32
# METRICS_TOKEN=

# Operator alert webhook for HTTP 5xx responses and failed background jobs.
# The optional secret signs the JSON body with HMAC-SHA256 in
# X-ChasteDesk-Signature.
# ALERT_WEBHOOK_URL=https://alerts.example.com/chastedesk
# ALERT_WEBHOOK_SECRET=

# TEST ONLY: allows the ingestion crawler to fetch private/loopback addresses.
# Read only when APP_ENV != production. Never set this in production.
# CHASTESK_INGEST_ALLOW_PRIVATE=1
